# Copy this file to .env and fill in your values

# OpenAI / LLM Configuration
API_KEY=your_openai_api_key_here
ENDPOINT=https://openrouter.ai/api/v1/chat/completions
MODEL=gpt-4o-mini

# Paper Fetching Configuration
TOP_PAPERS_COUNT=5  # Number of top papers to include in newsletter

# Newsletter Configuration
NEWSLETTER_NAME="Daily AI Papers"
NEWSLETTER_SERVICE=email  # Options: email, kit

# Output Configuration
OUTPUT_DIR=newsletter
MAX_CHARS=200000

# Email Configuration (if NEWSLETTER_SERVICE=email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_TO=recipient@example.com
EMAIL_FROM=  # Optional, defaults to SMTP_USER

# Kit.com Configuration (if NEWSLETTER_SERVICE=kit)
# Get your API Secret from Kit.com -> Settings -> Advanced -> API Secret
KIT_API_SECRET=your_kit_api_secret_here
